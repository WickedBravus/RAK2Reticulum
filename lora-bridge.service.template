[Unit]
Description=Native RAK LoRa Bridge
After=network.target rnsd.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__

# Universal Hardware reset sequence (GPIO 17 & 25)
ExecStartPre=/usr/bin/pinctrl set 17 op dh
ExecStartPre=/usr/bin/pinctrl set 25 op dh
ExecStartPre=/bin/sleep 0.2
ExecStartPre=/usr/bin/pinctrl set 17 op dl
ExecStartPre=/usr/bin/pinctrl set 25 op dl
ExecStartPre=/bin/sleep 0.2

# Main Executable
ExecStart=__DIR__/target/release/rns-rak-native
Restart=always
RestartSec=3

# Diagnostics (Uncomment when tracking C-driver crashes)
# Environment="RUST_BACKTRACE=full"

[Install]
WantedBy=multi-user.target
