[reticulum]
  enable_transport = True
  loglevel = 7  
  share_instance = Yes
  instance_name = default

[interfaces]

[[RustLoRaBridge]]
    type = UDPInterface
    interface_enabled = True
    listen_ip = 127.0.0.1
    listen_port = 4243
    forward_ip = 127.0.0.1
    forward_port = 4242
    mtu = 255

  [[iPhoneGateway]]
    type = TCPServerInterface
    interface_enabled = True
    listen_ip = 0.0.0.0
    listen_port = 4244

  [[Global_Testnet]]
    type = TCPClientInterface
    enabled = yes
    target_host = dublin.connect.reticulum.network
    target_port = 4965
