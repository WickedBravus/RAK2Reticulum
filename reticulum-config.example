[reticulum]
  # Enables this node to route traffic for other nodes in the mesh community
  enable_transport = True
  share_instance = Yes
  instance_name = default

[interfaces]

  # Link to the local RAK2Reticulum Rust Bridge
  # STRICT 255 MTU REQUIRED FOR PHYSICAL LORA LIMITS
  [[RustLoRaBridge]]
    type = UDPInterface
    interface_enabled = True
    listen_ip = 127.0.0.1
    listen_port = 4243
    forward_ip = 127.0.0.1
    forward_port = 4242
    mtu = 255
    bitrate = 6250

  # Accepts incoming TCP connections from iPhones/mobile apps on the local network
  [[iPhoneGateway]]
    type = TCPServerInterface
    interface_enabled = True
    listen_ip = 0.0.0.0
    listen_port = 4244

  # Connects this node to the global Reticulum Testnet routing hub, change no to yes to see your RAK miner transmitting global packets in LoRa
  [[RNS Testnet StoppedCold]]
    type = TCPClientInterface
    enabled = yes
    target_host = rns.stoppedcold.com
    target_port = 4242
    mode = boundary
